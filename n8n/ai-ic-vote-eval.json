    {
      "parameters": {
        "jsCode": "let b = null;\ntry {\n  b = $('Wait: Eval Result').first().json.body;\n} catch (e) {}\nconst finished = !!b && typeof b === 'object' && Number.isInteger(b.exit_code);\nconst exitCode = finished ? b.exit_code : null;\nconst raw = finished && typeof b.output === 'string' ? b.output.trim() : '';\nconst text = raw.length > 1200 ? raw.slice(0, 1200) + ' ...(trimmed)' : raw;\n// The first table row after the header and separator: | Company | Prompt | Words | Verdict | Conviction | Result | Detail |\nconst row = raw.split('\\n').map(l => l.trim()).filter(l => l.startsWith('|') && !/^\\|[\\s|:-]+\\|?$/.test(l))[1] || '';\nconst cells = row ? row.replace(/^\\|/, '').replace(/\\|\\s*$/, '').split('|').map(c => c.trim()) : [];\nconst company = cells[0] || 'unknown';\nconst prompt = cells[1] || 'unknown';\nconst problems = cells.length > 6 ? cells.slice(6).join(' | ').slice(0, 600) : '';\nreturn [{ json: { finished, failed: finished && exitCode !== 0, exit_code: exitCode, company, prompt, problems, text } }];"
      },
